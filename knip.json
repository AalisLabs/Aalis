{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "project": ["src/**/*.ts"]
    },
    "packages/plugin-webui-client": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreIssues": {
    "packages/plugin-adapter-onebot/src/types.ts": ["exports", "types"],
    "packages/plugin-adapter-onebot/src/forward.ts": ["types"],
    "packages/plugin-adapter-onebot/src/forward-expand.ts": ["types"],
    "packages/plugin-tool-code-runner/src/runner.ts": ["types"],
    "packages/plugin-webui-client/src/useDetailStream.ts": ["types"],
    "packages/plugin-webui-client/src/useSessionManager.ts": ["types"],
    "packages/plugin-webui-client/src/components/SchemaForm.tsx": ["exports"],
    "packages/plugin-webui-server/src/auth.ts": ["types"],
    "packages/plugin-webui-server/src/routes/files.ts": ["types"],
    "packages/plugin-authority/src/user-store.ts": ["types"],
    "packages/plugin-user-relation/src/extractor.ts": ["exports", "types"],
    "packages/plugin-user-relation/src/service.ts": ["types"]
  }
}
