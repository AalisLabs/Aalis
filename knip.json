{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "project": ["src/**/*.ts"]
    },
    "packages/plugin-webui-client": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/api-publish": {
      "ignoreDependencies": ["@aalis/core"]
    },
    "packages/plugin-draw": {
      "ignoreDependencies": ["@aalis/util-offline-render"]
    },
    "packages/plugin-paper": {
      "ignoreDependencies": ["@aalis/api-authority", "@aalis/api-publish"]
    },
    "packages/plugin-publish-review": {
      "ignoreDependencies": [
        "@aalis/api-code-sandbox",
        "@aalis/api-doctor",
        "@aalis/api-llm",
        "@aalis/api-publish",
        "@aalis/api-storage",
        "@aalis/api-tools",
        "@aalis/api-webui",
        "@aalis/schema-config",
        "@aalis/schema-message",
        "@aalis/util-json-repair",
        "@aalis/util-media-signature",
        "@aalis/util-offline-render"
      ]
    },
    "packages/plugin-works-site": {
      "ignoreDependencies": [
        "@aalis/api-doctor",
        "@aalis/api-publish",
        "@aalis/api-storage",
        "@aalis/api-webui",
        "@aalis/schema-config"
      ]
    },
    "packages/util-offline-render": {
      "ignoreDependencies": ["puppeteer"]
    }
  },
  "ignoreIssues": {
    "packages/plugin-adapter-onebot/src/types.ts": ["exports", "types"],
    "packages/plugin-adapter-onebot/src/forward.ts": ["types"],
    "packages/plugin-adapter-onebot/src/forward-expand.ts": ["types"],
    "packages/plugin-tool-code-runner/src/runner.ts": ["types"],
    "packages/plugin-webui-client/src/useDetailStream.ts": ["types"],
    "packages/plugin-webui-client/src/useSessionManager.ts": ["types"],
    "packages/plugin-webui-client/src/components/SchemaForm.tsx": ["exports"],
    "packages/plugin-webui-server/src/auth.ts": ["types"],
    "packages/plugin-webui-server/src/routes/files.ts": ["types"],
    "packages/plugin-authority/src/user-store.ts": ["types"],
    "packages/plugin-user-relation/src/extractor.ts": ["exports", "types"],
    "packages/plugin-user-relation/src/service.ts": ["types"]
  }
}
