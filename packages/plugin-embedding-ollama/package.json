        "lifecycle",
        "logger",
        "provide"
      ]
    }
  },
  "dependencies": {
    "@aalis/api-doctor": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-embedding": "workspace:>=0.9.0 <1.0.0",
    "@aalis/schema-config": "workspace:>=0.16.0 <1.0.0",
