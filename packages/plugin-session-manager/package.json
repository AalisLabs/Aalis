{
  "name": "@aalis/plugin-session-manager",
  "version": "0.9.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-session-manager"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "会话管理：生命周期、平台配置、会话树",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/schema-config": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-llm": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-session-manager": "workspace:>=0.6.0 <1.0.0",
    "@aalis/api-webui": "workspace:>=0.9.0 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/api-agent": "workspace:*",
    "@aalis/api-memory": "workspace:*",
    "@aalis/schema-message": "workspace:*",
    "@aalis/api-persona": "workspace:*",
    "@aalis/api-tools": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.11.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "required": [
        "memory"
      ],
      "optional": [
        "agent",
        "platform",
        "persona",
        "llm"
      ],
      "provides": [
        "session-manager"
      ]
    }
  }
}
