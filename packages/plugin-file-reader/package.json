{
  "name": "@aalis/plugin-file-reader",
  "version": "0.10.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-file-reader"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "文件读取：解析多种格式文件供 AI 理解",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/api-agent": "workspace:>=0.6.0 <1.0.0",
    "@aalis/schema-config": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-storage": "workspace:>=0.5.5 <1.0.0",
    "@aalis/api-tools": "workspace:>=0.5.1 <1.0.0",
    "mammoth": "^1.8.0",
    "unpdf": "^0.12.1"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/api-media": "workspace:*",
    "@aalis/api-memory": "workspace:*",
    "@aalis/schema-message": "workspace:*",
    "@aalis/api-session-manager": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.11.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "required": [
        "storage"
      ],
      "optional": [
        "agent",
        "memory",
        "media"
      ],
      "provides": [
        "file-reader"
      ]
    }
  }
}
