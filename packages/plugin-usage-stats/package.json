    "@aalis/schema-config": "workspace:>=0.14.0 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.18.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "required": [
        "config",
        "events",
        "host-paths",
        "lifecycle",
        "logger"
      ],
      "optional": [
        "llm",
        "plugins",
        "webui-server"
      ]
    }
  }
}
