    "@aalis/api-tools": "workspace:>=0.10.0 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.18.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "optional": [
        "tools",
        "platform",
        "storage",
        "media",
        "session-history"
      ],
      "required": [
        "config",
        "events",
        "logger"
      ]
    }
  }
