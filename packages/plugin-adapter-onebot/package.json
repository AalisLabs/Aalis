{
  "name": "@aalis/plugin-adapter-onebot",
  "version": "0.14.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-adapter-onebot"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "OneBot v11/v12 协议适配器（QQ 等平台接入，多连接 + 自动重连）",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/api-flow-control": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-llm": "workspace:>=0.12.0 <1.0.0",
    "@aalis/api-media": "workspace:>=0.11.0 <1.0.0",
    "@aalis/api-memory": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-message-archive": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-platform": "workspace:>=0.8.0 <1.0.0",
    "@aalis/api-process": "workspace:>=0.8.0 <1.0.0",
    "@aalis/api-storage": "workspace:>=0.7.0 <1.0.0",
    "@aalis/schema-config": "workspace:>=0.13.0 <1.0.0",
    "@aalis/schema-message": "workspace:>=0.9.0 <1.0.0",
    "@aalis/util-network-guard": "workspace:>=0.6.2 <1.0.0",
    "@aalis/util-text-normalize": "workspace:>=0.5.2 <1.0.0",
    "ws": "^8.18.0",
    "@aalis/api-contributions": "workspace:>=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/api-agent": "workspace:*",
    "@aalis/api-webui": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.18.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "required": [
        "config",
        "contributions",
        "events",
        "lifecycle",
        "logger",
        "process",
        "provide",
        "storage"
      ],
      "optional": [
        "flow-control",
        "llm",
        "media",
        "memory",
        "message-archive"
      ],
      "provides": [
        "platform"
      ]
    }
  }
}
