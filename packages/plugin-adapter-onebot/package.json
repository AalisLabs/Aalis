{
  "name": "@aalis/plugin-adapter-onebot",
  "version": "0.10.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-adapter-onebot"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "OneBot v11/v12 协议适配器（QQ 等平台接入，多连接 + 自动重连）",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/api-llm": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-process": "workspace:>=0.5.0 <1.0.0",
    "@aalis/api-storage": "workspace:>=0.5.5 <1.0.0",
    "@aalis/schema-config": "workspace:>=0.9.0 <1.0.0",
    "@aalis/schema-message": "workspace:>=0.6.0 <1.0.0",
    "@aalis/util-network-guard": "workspace:>=0.5.1 <1.0.0",
    "@aalis/util-text-normalize": "workspace:>=0.5.1 <1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/api-agent": "workspace:*",
    "@aalis/api-flow-control": "workspace:*",
    "@aalis/api-media": "workspace:*",
    "@aalis/api-memory": "workspace:*",
    "@aalis/api-message-archive": "workspace:*",
    "@aalis/api-platform": "workspace:*",
    "@aalis/api-webui": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.11.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "required": [
        "storage",
        "process"
      ],
      "optional": [
        "llm",
        "commands",
        "message-archive",
        "persona",
        "flow-control"
      ],
      "provides": [
        "platform"
      ]
    }
  }
}
