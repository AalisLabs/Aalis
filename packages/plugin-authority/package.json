    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/api-authority": "workspace:>=0.5.0 <1.0.0",
    "@aalis/api-commands": "workspace:>=0.5.0 <1.0.0",
    "@aalis/api-platform": "workspace:>=0.5.0 <1.0.0",
    "@aalis/api-storage": "workspace:>=0.5.5 <1.0.0",
    "@aalis/api-webui": "workspace:>=0.9.0 <1.0.0",
    "@aalis/util-network-guard": "workspace:>=0.5.1 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/api-tools": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.2.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "optional": [
        "commands",
        "tools"
      ],
      "provides": [
        "authority"
      ]
    }
  }
