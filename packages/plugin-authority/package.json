{
  "name": "@aalis/plugin-authority",
  "version": "0.14.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-authority"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "权限系统：数字等级与权限组授权、高危操作确认、网络出口闸（单 owner）",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/api-approval": "workspace:>=0.2.0 <1.0.0",
    "@aalis/api-authority": "workspace:>=0.12.0 <1.0.0",
    "@aalis/api-commands": "workspace:>=0.8.0 <1.0.0",
    "@aalis/api-contributions": "workspace:>=0.2.0 <1.0.0",
    "@aalis/api-storage": "workspace:>=0.8.0 <1.0.0",
    "@aalis/api-webui": "workspace:>=0.13.0 <1.0.0",
    "@aalis/api-tools": "workspace:>=0.12.0 <1.0.0",
    "@aalis/util-network-guard": "workspace:>=0.6.2 <1.0.0",
    "@aalis/api-host-config": "workspace:>=0.3.0 <1.0.0",
    "@aalis/api-session-settings": "workspace:>=0.1.0 <1.0.0",
    "@aalis/schema-config": "workspace:>=0.16.0 <1.0.0",
    "@aalis/schema-i18n": "workspace:>=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.20.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "optional": [
        "host-config",
        "webui-server",
        "commands",
        "tools",
        "storage",
        "approvals",
        "session-settings",
        "contributions"
      ],
      "provides": [
        "authority"
      ],
      "required": [
        "lifecycle",
        "logger",
        "provide"
      ]
    }
  }
}
