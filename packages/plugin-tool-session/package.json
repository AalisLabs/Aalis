{
  "name": "@aalis/plugin-tool-session",
  "version": "0.14.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-tool-session"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "会话工具：按 sessionId 读取会话历史，提供 session_get_history 工具与 session-history 服务",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/schema-config": "workspace:>=0.14.0 <1.0.0",
    "@aalis/api-gateway": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-memory": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-session-history": "workspace:>=0.1.0 <1.0.0",
    "@aalis/api-session-manager": "workspace:>=0.10.0 <1.0.0",
    "@aalis/api-tools": "workspace:>=0.10.0 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/schema-message": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.18.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "optional": [
        "tools",
        "memory",
        "session-manager"
      ],
      "provides": [
        "session-history"
      ],
      "required": [
        "config",
        "logger",
        "provide"
      ]
    }
  }
}
