  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/schema-message": "workspace:>=0.11.0 <1.0.0",
    "@aalis/api-agent": "workspace:>=0.11.0 <1.0.0",
    "@aalis/schema-config": "workspace:>=0.16.0 <1.0.0",
    "@aalis/api-flow-control": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-gateway": "workspace:>=0.10.0 <1.0.0",
    "@aalis/api-message-archive": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-storage": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-hooks": "workspace:>=0.3.0 <1.0.0",
    "@aalis/api-session-manager": "workspace:>=0.12.0 <1.0.0",
    "@aalis/api-host-config": "workspace:>=0.3.0 <1.0.0",
    "@aalis/api-session-settings": "workspace:>=0.1.0 <1.0.0",
    "@aalis/schema-i18n": "workspace:>=0.1.0 <1.0.0",
    "@aalis/api-events": "workspace:>=0.1.0 <1.0.0"
