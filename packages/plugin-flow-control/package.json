{
  "name": "@aalis/plugin-flow-control",
  "version": "0.17.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-flow-control"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "平台无关流控：禁言/冷却/限速",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
