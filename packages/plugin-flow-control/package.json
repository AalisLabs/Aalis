  "aalis": {
    "service": {
      "required": [
        "config",
        "events",
        "hooks",
        "lifecycle",
        "logger",
        "provide",
        "storage"
      ],
      "optional": [
        "message-archive",
        "session-manager",
        "session-settings",
        "host-config",
        "agent"
      ],
      "provides": [
        "flow-control"
      ]
