{
  "name": "@aalis/plugin-agent",
  "version": "0.15.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-agent"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "对话编排核心：消息构建、工具循环、上下文管理",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
