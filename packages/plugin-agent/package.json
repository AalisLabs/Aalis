{
  "name": "@aalis/plugin-agent",
  "version": "0.9.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-agent"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "对话编排核心：消息构建、工具循环、上下文管理",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/api-agent": "workspace:>=0.6.0 <1.0.0",
    "@aalis/api-commands": "workspace:>=0.5.0 <1.0.0",
    "@aalis/schema-config": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-llm": "workspace:>=0.9.0 <1.0.0",
    "@aalis/schema-message": "workspace:>=0.5.1 <1.0.0",
    "@aalis/api-platform": "workspace:>=0.5.0 <1.0.0",
    "@aalis/util-text-normalize": "workspace:>=0.5.1 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/api-gateway": "workspace:*",
    "@aalis/api-memory": "workspace:*",
    "@aalis/api-message-archive": "workspace:*",
    "@aalis/api-persona": "workspace:*",
    "@aalis/api-session-manager": "workspace:*",
    "@aalis/api-tools": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.8.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "optional": [
        "llm",
        "memory",
        "persona",
        "message-archive",
        "platform"
      ],
      "provides": [
        "agent"
      ]
    }
  }
}
