  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/api-agent": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-commands": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-gateway": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-llm": "workspace:>=0.12.0 <1.0.0",
    "@aalis/api-media": "workspace:>=0.11.0 <1.0.0",
    "@aalis/api-memory": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-message-archive": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-persona": "workspace:>=0.8.0 <1.0.0",
    "@aalis/api-platform": "workspace:>=0.8.0 <1.0.0",
    "@aalis/api-session-manager": "workspace:>=0.10.0 <1.0.0",
    "@aalis/api-storage": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-tools": "workspace:>=0.10.0 <1.0.0",
    "@aalis/schema-config": "workspace:>=0.13.0 <1.0.0",
    "@aalis/schema-message": "workspace:>=0.9.0 <1.0.0",
    "@aalis/util-text-normalize": "workspace:>=0.5.2 <1.0.0",
    "@aalis/api-hooks": "workspace:>=0.1.0 <1.0.0",
    "@aalis/api-contributions": "workspace:>=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.18.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "optional": [
        "commands",
        "gateway",
        "llm",
        "media",
        "memory",
        "message-archive",
        "persona",
        "platform",
        "plugins",
        "session-manager",
        "storage",
        "tools"
      ],
      "provides": [
        "agent"
      ],
      "required": [
        "config",
        "contributions",
        "events",
        "hooks",
        "lifecycle",
        "logger",
        "provide",
        "services"
      ]
    }
  }
}
