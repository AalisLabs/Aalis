{
  "name": "@aalis/plugin-sts2",
  "version": "0.1.0",
  "description": "杀戮尖塔2 游戏身体——AI 作为玩家爬塔,交流可影响其决策",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/plugin-platform-api": "workspace:^",
    "@aalis/plugin-message-api": "workspace:^",
    "@aalis/plugin-memory-api": "workspace:^",
    "@aalis/plugin-tools-api": "workspace:^",
    "@aalis/plugin-agent-api": "workspace:^"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.2.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "optional": [
        "memory",
        "agent"
      ],
      "provides": [
        "platform"
      ]
    }
  }
}
