{
  "name": "@aalis/plugin-commands",
  "version": "0.12.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-commands"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "斜杠指令系统：注册与分发 /command",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/api-authority": "workspace:>=0.10.0 <1.0.0",
    "@aalis/api-commands": "workspace:>=0.7.0 <1.0.0",
    "@aalis/schema-config": "workspace:>=0.13.0 <1.0.0",
    "@aalis/api-gateway": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-memory": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-storage": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-hooks": "workspace:>=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/api-tools": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.18.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "required": [
        "config",
        "events",
        "gateway",
        "hooks",
        "logger",
        "provide",
        "services"
      ],
      "optional": [
        "commands",
        "storage",
        "memory",
        "authority",
        "app"
      ],
      "provides": [
        "commands"
      ]
    }
  }
}
