    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/schema-config": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-cron-engine": "workspace:>=0.5.1 <1.0.0",
    "@aalis/api-storage": "workspace:>=0.5.5 <1.0.0",
    "@aalis/api-tools": "workspace:>=0.5.1 <1.0.0",
    "@aalis/api-webui": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-workflow": "workspace:>=0.9.0 <1.0.0",
