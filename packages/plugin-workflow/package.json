  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/api-agent": "workspace:*",
    "@aalis/schema-message": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.11.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "required": [
        "cron-engine"
      ],
      "optional": [
        "tools",
        "storage",
        "webui"
      ],
      "provides": [
        "workflow"
      ]
    }
  }
