{
  "name": "@aalis/plugin-user-profile",
  "version": "0.10.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-user-profile"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "用户画像：记录与检索用户信息",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "eval:behavior": "node evals/profile-behavior-eval.mjs"
  },
  "dependencies": {
    "@aalis/api-commands": "workspace:>=0.5.0 <1.0.0",
    "@aalis/schema-config": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-llm": "workspace:>=0.9.0 <1.0.0",
    "@aalis/schema-message": "workspace:>=0.5.1 <1.0.0",
    "@aalis/api-tools": "workspace:>=0.5.1 <1.0.0",
    "@aalis/util-json-repair": "workspace:>=0.5.1 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/api-agent": "workspace:*",
    "@aalis/api-memory": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.11.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "required": [
        "memory",
        "llm"
      ],
      "optional": [
        "user-relation",
        "tools"
      ]
    }
  }
}
