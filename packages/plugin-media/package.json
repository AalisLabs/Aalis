{
  "name": "@aalis/plugin-media",
  "version": "0.12.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-media"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "媒体处理：音视频/图片的转码与收发支撑",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/api-agent": "workspace:>=0.6.0 <1.0.0",
    "@aalis/schema-config": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-llm": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-media": "workspace:>=0.9.0 <1.0.0",
    "@aalis/schema-message": "workspace:>=0.5.1 <1.0.0",
    "@aalis/api-process": "workspace:>=0.5.0 <1.0.0",
    "@aalis/api-storage": "workspace:>=0.5.5 <1.0.0",
    "@aalis/api-tools": "workspace:>=0.5.1 <1.0.0",
    "@aalis/util-bounded-map": "workspace:>=0.6.0 <1.0.0",
    "@aalis/util-network-guard": "workspace:>=0.5.1 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/api-asr": "workspace:*",
    "@aalis/api-memory": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.11.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "required": [
        "process",
        "storage"
      ],
      "optional": [
        "llm",
        "agent",
        "asr"
      ],
      "provides": [
        "media"
      ]
    }
  }
}
