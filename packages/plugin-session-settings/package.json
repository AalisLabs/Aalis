{
  "name": "@aalis/plugin-session-settings",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-session-settings"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "会话设置：插件配置字段按平台档、平台类型档、场所与会话覆盖的存放、解析与修改，以及 /session 系列指令",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/api-authority": "workspace:>=0.12.0 <1.0.0",
    "@aalis/api-commands": "workspace:>=0.8.0 <1.0.0",
    "@aalis/api-gateway": "workspace:>=0.10.0 <1.0.0",
    "@aalis/api-host-config": "workspace:>=0.3.0 <1.0.0",
    "@aalis/api-platform": "workspace:>=0.10.0 <1.0.0",
    "@aalis/api-session-manager": "workspace:>=0.12.0 <1.0.0",
    "@aalis/api-session-settings": "workspace:>=0.1.0 <1.0.0",
    "@aalis/schema-config": "workspace:>=0.16.0 <1.0.0",
    "@aalis/schema-i18n": "workspace:>=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.21.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "required": [
        "events",
        "logger",
        "provide",
        "services",
        "session-manager"
      ],
      "optional": [
        "authority",
        "commands",
        "host-config",
        "platform"
      ],
      "provides": [
        "session-settings"
      ]
    }
  }
}
