{
  "name": "@aalis/plugin-cli",
  "version": "0.11.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-cli"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "CLI 终端平台适配器：在终端直接与 AI 对话",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/schema-config": "workspace:>=0.12.0 <1.0.0",
    "@aalis/api-persona": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-platform": "workspace:>=0.7.0 <1.0.0",
    "@aalis/api-storage": "workspace:>=0.6.0 <1.0.0",
    "chalk": "^5.4.0",
    "cli-truncate": "^6.0.0",
    "string-width": "^8.2.0",
    "@aalis/schema-log": "workspace:>=0.1.0 <1.0.0",
    "@aalis/api-host-config": "workspace:>=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/schema-message": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.17.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "optional": [
        "platform",
        "persona",
        "storage",
        "host-config"
      ],
      "provides": [
        "cli",
        "platform"
      ],
      "required": [
        "config",
        "events",
        "lifecycle",
        "logger",
        "provide",
        "services"
      ]
    }
  }
}
