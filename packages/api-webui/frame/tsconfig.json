{
  // 框架侧的助手按浏览器环境单独编译，输出到 dist/frame/，与样式基线一起由 webui-server 托管在 /frames/_base/ 下。
  // 本包的类型取自编译出的声明（先跑本包的 tsc）；运行时只导入 @aalis/schema-i18n，build.mjs 把它换成随本包带的那一份
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "../dist/frame",
    "lib": ["ES2022", "DOM"],
    "types": [],
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": { "@aalis/api-webui": ["../dist/index.d.ts"] }
  },
  "include": ["frame.ts"]
}
