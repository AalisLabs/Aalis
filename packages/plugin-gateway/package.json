{
  "name": "@aalis/plugin-gateway",
  "version": "0.10.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-gateway"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "消息网关：入站/出站编排（指令→触发→流控→分发相位）",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/schema-message": "workspace:>=0.11.0 <1.0.0",
    "@aalis/api-agent": "workspace:>=0.11.0 <1.0.0",
    "@aalis/api-authority": "workspace:>=0.12.0 <1.0.0",
    "@aalis/api-gateway": "workspace:>=0.10.0 <1.0.0",
    "@aalis/api-hooks": "workspace:>=0.3.0 <1.0.0",
    "@aalis/api-i18n": "workspace:>=0.1.0 <1.0.0",
    "@aalis/api-platform": "workspace:>=0.11.0 <1.0.0",
    "@aalis/api-session-manager": "workspace:>=0.12.0 <1.0.0",
    "@aalis/schema-i18n": "workspace:>=0.1.0 <1.0.0",
    "@aalis/api-events": "workspace:>=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.22.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "optional": [
        "agent",
        "authority",
        "i18n",
        "platform",
        "session-manager"
      ],
      "provides": [
        "gateway"
      ],
      "required": [
        "events",
        "hooks",
        "logger",
        "provide"
      ]
    }
  }
}
