{
  "name": "@aalis/plugin-package-manager",
  "version": "0.11.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git",
    "directory": "packages/plugin-package-manager"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "description": "插件包管理：从 npm 安装/卸载/更新到项目根 dependencies",
  "type": "module",
  "keywords": [
    "aalis",
    "aalis-plugin"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@aalis/api-doctor": "workspace:>=0.9.0 <1.0.0",
    "@aalis/api-process": "workspace:>=0.10.0 <1.0.0",
    "@aalis/util-dep-spec": "workspace:>=0.1.1 <1.0.0",
    "@aalis/api-plugin-source": "workspace:>=0.3.0 <1.0.0",
    "@aalis/api-host-config": "workspace:>=0.3.0 <1.0.0",
    "@aalis/api-host-paths": "workspace:>=0.1.0 <1.0.0",
    "@aalis/api-host-restart": "workspace:>=0.1.0 <1.0.0",
    "@aalis/api-package-manager": "workspace:>=0.3.0 <1.0.0",
    "@aalis/schema-i18n": "workspace:>=0.1.0 <1.0.0"
  },
  "devDependencies": {
    "@aalis/core": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@aalis/core": ">=0.21.0 <1.0.0"
  },
  "aalis": {
    "service": {
      "required": [
        "host-paths",
        "lifecycle",
        "logger",
        "plugins",
        "process",
        "provide",
        "services"
      ],
      "optional": [
        "host-config",
        "host-restart",
        "plugin-source"
      ],
      "provides": [
        "package-manager"
      ]
    }
  }
}
