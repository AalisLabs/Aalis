{
  "name": "aalis",
  "version": "0.5.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AalisLabs/Aalis.git"
  },
  "author": "Ace Nyan <ace@acenyan.com>",
  "bugs": {
    "url": "https://github.com/AalisLabs/Aalis/issues"
  },
  "homepage": "https://github.com/AalisLabs/Aalis#readme",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build && tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check:biome": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage:core": "vitest run -c vitest.core-coverage.config.ts",
    "ci": "pnpm -r build && pnpm run check:biome && pnpm run test",
    "ci:local": "pnpm -r build && pnpm run check:biome && pnpm run test",
    "preflight": "pnpm run clean && pnpm -r build && pnpm test && pnpm run coverage:core && pnpm exec biome check . && pnpm exec knip --no-progress",
    "publish:dry": "pnpm run clean && pnpm -r build && pnpm -r publish --dry-run --no-git-checks",
    "publish:all": "pnpm run clean && pnpm -r build && pnpm -r publish --access public --no-git-checks",
    "prepare": "husky",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "devDependencies": {
    "@aalis/api-commands": "workspace:*",
    "@aalis/api-gateway": "workspace:*",
    "@aalis/api-process": "workspace:*",
    "@aalis/api-storage": "workspace:*",
    "@aalis/api-tools": "workspace:*",
    "@aalis/api-webui": "workspace:*",
    "@aalis/schema-config": "workspace:*",
    "@aalis/schema-message": "workspace:*",
    "@biomejs/biome": "2.4.15",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "better-sqlite3": "^11.10.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "knip": "^5.88.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "yaml": "^2.7.0",
    "@aalis/schema-log": "workspace:*"
  },
  "dependencies": {
    "@aalis/core": "workspace:*",
    "@aalis/runtime": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "puppeteer"
    ],
    "ignoredBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
